# 333 Network Backend — example environment configuration
# Copy this file to .env for local use.
# Never commit the real .env file or real secrets.

# Application
APP_NAME=333 Network API
APP_ENV=development
APP_DEBUG=false
APP_MODULE=app.main:app
API_PREFIX=/api
HOST=0.0.0.0
PORT=8000
ENABLE_API_DOCS=true
GZIP_MINIMUM_SIZE=1024

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# Public URLs
API_PUBLIC_URL=http://localhost:8000
FRONTEND_PUBLIC_URL=http://localhost:5500

# Exact frontend origins, comma-separated
FRONTEND_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,https://vervenveda.com,https://www.vervenveda.com,https://vervenveda.github.io

# Hostnames accepted by FastAPI TrustedHostMiddleware
TRUSTED_HOSTS=localhost,127.0.0.1,testserver

# PostgreSQL
POSTGRES_DB=network333
POSTGRES_USER=network333
POSTGRES_PASSWORD=replace-with-a-long-random-local-password
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://network333:replace-with-a-long-random-local-password@db:5432/network333
DATABASE_ECHO=false
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT_SECONDS=30
DATABASE_HEALTH_TIMEOUT_SECONDS=3
DATABASE_REQUIRED_ON_STARTUP=false

# Redis
REDIS_URL=redis://redis:6379/0

# Identity and authentication
JWT_SECRET=replace-with-at-least-64-random-characters
SESSION_SECRET=replace-with-a-different-64-character-random-secret
JWT_ISSUER=333-network
JWT_AUDIENCE=333-network-api
TOKEN_SIGNING_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30
MINIMUM_PASSWORD_LENGTH=12
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15

# Rate limits
REGISTRATION_RATE_LIMIT=5
LOGIN_RATE_LIMIT=20
REFRESH_RATE_LIMIT=60
EMAIL_APPLICATION_RATE_LIMIT=5
RATE_LIMIT_FAIL_CLOSED=false

# Cookies
COOKIE_NAME=network333_session
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=

# HOLLO / 333 identity
NETWORK_NUMBER_PREFIX=333
NETWORK_NUMBER_TOTAL_DIGITS=10

# E=Ven Mail
# Replace this placeholder before production.
EVEN_MAIL_ALLOWED_DOMAINS=evenmail.example.invalid

# Initial administration
# Do not place a real administrator password here.
ADMIN_BOOTSTRAP_TOKEN=replace-with-a-long-one-time-bootstrap-token

# Object storage placeholders
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_REGION=
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=

# SMTP placeholders
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=
SMTP_USE_TLS=true

# KANSEE placeholders
STUN_URLS=
TURN_URLS=
TURN_USERNAME=
TURN_CREDENTIAL=

# SIte / Bunya provider placeholders
DEPLOYMENT_PROVIDER=
DEPLOYMENT_API_TOKEN=
DNS_PROVIDER=
DNS_API_TOKEN=

# Monitoring
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=

# Retention defaults
AUDIT_LOG_RETENTION_DAYS=365
REFRESH_SESSION_RETENTION_DAYS=90
EMAIL_APPLICATION_RETENTION_DAYS=730
