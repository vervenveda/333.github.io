    {"name": "KANSEE Meeting Rooms", "short_name": "KANSEE", "description": "Open private rooms, scheduled meetings, invitations, chat, and local media previews.", "url": "./app/KANSEE_333_meeting_rooms_index.html", "icons": [{"src": "./assets/icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any"}]},
    {"name": "E=Ven Mail", "short_name": "E=Ven Mail", "description": "Open the local-first email application and correspondence workspace.", "url": "./app/EVen_mail_index.html", "icons": [{"src": "./assets/icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any"}]},
    {"name": "Bazaar Art Live", "short_name": "Bazaar Live", "description": "Open the creative community feed, groups, events, posts, and reels.", "url": "./app/Bazaar_Art_Live_index.html", "icons": [{"src": "./assets/icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any"}]},
